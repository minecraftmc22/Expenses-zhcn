<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      One overlay per accent a user can pick. The activity applies the chosen one on top of its
      theme at the very start of onCreate, which repaints the toolbars, headers, buttons and the
      amount highlights without touching any layout.
    -->

    <style name="ThemeOverlay.Expenses.ThemeColor.Default" parent="">
        <item name="themeColor">@color/expenses_blue</item>
        <item name="colorPrimary">@color/expenses_blue</item>
        <item name="colorPrimaryVariant">@color/expenses_blue_dark</item>
        <item name="colorPrimaryDark">@color/expenses_blue_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
    </style>

