<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_xlarge"
        android:paddingTop="@dimen/spacing_large"
        android:paddingEnd="@dimen/spacing_xlarge"
        android:paddingBottom="@dimen/spacing_xlarge">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/previewImageView"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@color/color_on_surface_emphasis_divider"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_normal"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chooseImageButton"
                style="@style/Widget.Expenses.Button.Normal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/choose_image" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearBackgroundButton"
                style="@style/Widget.Expenses.TextButton.Normal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_normal"
                android:layout_weight="1"
                android:text="@string/clear_background" />

        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/opacityLabelTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textColor="@color/color_on_surface_emphasis_high" />

        <!-- max values match BackgroundSettings.OPACITY_MAX -->
        <SeekBar
            android:id="@+id/opacitySeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/blurLabelTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textColor="@color/color_on_surface_emphasis_high" />

        <!-- max value matches BackgroundSettings.BLUR_MAX -->
        <SeekBar
            android:id="@+id/blurSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="25" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/brightnessLabelTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textColor="@color/color_on_surface_emphasis_high" />

        <!-- max value matches BackgroundSettings.BRIGHTNESS_MAX -->
        <SeekBar
            android:id="@+id/brightnessSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="200" />

    </LinearLayout>

</ScrollView>
