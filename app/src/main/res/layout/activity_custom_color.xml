<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_big"
        android:paddingTop="@dimen/spacing_normal"
        android:paddingEnd="@dimen/spacing_big"
        android:paddingBottom="@dimen/spacing_large">

        <View
            android:id="@+id/customColorPreview"
            android:layout_width="match_parent"
            android:layout_height="96dp" />

        <TextView
            android:id="@+id/textRedChannel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_normal"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/color_on_surface_emphasis_medium" />

        <SeekBar
            android:id="@+id/seekBarRed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="255" />

        <TextView
            android:id="@+id/textGreenChannel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/color_on_surface_emphasis_medium" />

        <SeekBar
            android:id="@+id/seekBarGreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="255" />

        <TextView
            android:id="@+id/textBlueChannel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/color_on_surface_emphasis_medium" />

        <SeekBar
            android:id="@+id/seekBarBlue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="255" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonApplyColor"
            style="@style/Widget.Expenses.Button.Normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/ok" />

    </LinearLayout>

</ScrollView>
